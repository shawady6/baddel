{
  "manifest_version": 3,
  "name": "Baddel – بدّل: Arabic ↔ English Fixer",
  "version": "1.3.0",
  "description": "Fix text typed in the wrong keyboard language (Arabic ↔ English) with one shortcut. Works locally, collects no data.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "background": { "service_worker": "service_worker.js" },
  "action": {
    "default_title": "Baddel – بدّل",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
